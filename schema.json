{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenacious-bench.local/tenacious_bench_v0.1.schema.json",
  "title": "Tenacious-Bench v0.1 Task",
  "description": "Machine-verifiable B2B sales evaluation task for Tenacious-style outreach, capacity safety, and judge filtering.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "version",
    "partition",
    "source_mode",
    "probe_id",
    "failure_dimension",
    "input",
    "ground_truth",
    "candidate_output",
    "reference_output",
    "negative_output",
    "metadata"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TB-V01-[0-9]{4}$"
    },
    "version": {
      "const": "0.1"
    },
    "partition": {
      "enum": [
        "train",
        "dev",
        "held_out"
      ]
    },
    "source_mode": {
      "enum": [
        "trace_derived",
        "programmatic",
        "multi_llm_synthesis",
        "hand_authored_adversarial"
      ]
    },
    "probe_id": {
      "type": "string",
      "pattern": "^W10-P[0-9]{2}$"
    },
    "failure_dimension": {
      "enum": [
        "capacity_grounding",
        "timezone_stack_feasibility",
        "start_date_truthfulness",
        "confidence_alignment",
        "signal_fabrication",
        "pricing_scope_control",
        "single_ask_structure",
        "prospect_safe_language",
        "non_condescending_competitor_gap",
        "channel_scheduling_handoff"
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "prospect",
        "signal_brief",
        "bench_summary",
        "requested_capacity",
        "pricing_scope",
        "prior_thread",
        "outreach_goal",
        "channel"
      ],
      "properties": {
        "prospect": {
          "type": "object",
          "required": [
            "company",
            "contact_name",
            "title",
            "segment"
          ]
        },
        "signal_brief": {
          "type": "object",
          "required": [
            "summary",
            "confidence",
            "source_window",
            "signals"
          ],
          "properties": {
            "confidence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "text",
                  "confidence"
                ]
              }
            }
          }
        },
        "bench_summary": {
          "type": "object",
          "required": [
            "available_capacity"
          ],
          "properties": {
            "available_capacity": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "stack",
                  "role",
                  "seniority",
                  "available_headcount",
                  "earliest_start_days",
                  "timezone_overlap_hours"
                ]
              }
            }
          }
        },
        "requested_capacity": {
          "type": "object",
          "required": [
            "headcount",
            "role",
            "stack",
            "seniority",
            "timeline_days",
            "timezone_overlap_hours"
          ]
        },
        "pricing_scope": {
          "type": "object",
          "required": [
            "allowed_amounts",
            "allowed_phrases",
            "can_quote_total_contract_value"
          ]
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "required_signal_terms",
        "expected_confidence_posture",
        "must_route_human",
        "forbidden_claims",
        "allowed_pricing_terms",
        "max_asks",
        "body_word_limit",
        "subject_char_limit",
        "inclusion_thresholds"
      ]
    },
    "candidate_output": {
      "$ref": "#/$defs/outreach_output"
    },
    "reference_output": {
      "$ref": "#/$defs/outreach_output"
    },
    "negative_output": {
      "$ref": "#/$defs/outreach_output"
    },
    "metadata": {
      "type": "object",
      "required": [
        "generation_model_family",
        "generation_model",
        "judge_model_family",
        "judge_model",
        "seed",
        "judge_filter"
      ],
      "properties": {
        "generation_model_family": {
          "type": "string"
        },
        "judge_model_family": {
          "type": "string"
        },
        "judge_filter": {
          "type": "object",
          "required": [
            "scores",
            "thresholds",
            "accepted",
            "leakage_risk"
          ]
        }
      }
    }
  },
  "$defs": {
    "outreach_output": {
      "type": "object",
      "required": [
        "subject",
        "body"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
